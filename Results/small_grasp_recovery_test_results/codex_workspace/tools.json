[
  {
    "type": "function",
    "name": "robodojo_start",
    "description": "Blocking: start the requested RoboDojo episode; save and return current RGB/proprio.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task": {
          "type": "string"
        },
        "output_dir": {
          "type": "string"
        }
      },
      "required": [
        "task",
        "output_dir"
      ]
    }
  },
  {
    "type": "function",
    "name": "pi05_infer",
    "description": "Blocking: infer pi05 once from the latest observation; save chunk and return full robot-only FK. action_diagnostics provides shape, finiteness, opening ranges and maximum successive joint step. Use these for routine arithmetic; native tools remain available for independent or additional checks. Diagnostics are not a safety or gate verdict: perform the unchanged visual and intent assessment.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observation_path": {
          "type": "string"
        },
        "output_dir": {
          "type": "string"
        }
      },
      "required": [
        "observation_path",
        "output_dir"
      ]
    }
  },
  {
    "type": "function",
    "name": "robodojo_execute",
    "description": "Blocking: validate and execute a reviewed fresh chunk or short EEF correction; save and return new observation and terminal result.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proposal_path": {
          "type": "string"
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string"
            },
            "mode": {
              "type": "string",
              "enum": [
                "student",
                "edit",
                "eef",
                "stop"
              ]
            },
            "steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 15
            },
            "reason": {
              "type": "string"
            },
            "edit": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "left": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "delta_position": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "delta_rotation_vector": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "gripper": {
                      "type": "string",
                      "enum": [
                        "keep",
                        "open",
                        "closed"
                      ]
                    }
                  },
                  "required": [
                    "delta_position",
                    "delta_rotation_vector",
                    "gripper"
                  ]
                },
                "right": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "delta_position": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "delta_rotation_vector": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "gripper": {
                      "type": "string",
                      "enum": [
                        "keep",
                        "open",
                        "closed"
                      ]
                    }
                  },
                  "required": [
                    "delta_position",
                    "delta_rotation_vector",
                    "gripper"
                  ]
                }
              },
              "required": [
                "left",
                "right"
              ]
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "left": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "position": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "quaternion_wxyz": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    "gripper_closed": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "position",
                    "quaternion_wxyz",
                    "gripper_closed"
                  ]
                },
                "right": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "position": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "quaternion_wxyz": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    "gripper_closed": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "position",
                    "quaternion_wxyz",
                    "gripper_closed"
                  ]
                }
              },
              "required": [
                "left",
                "right"
              ]
            },
            "assessment": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "task_progress": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "verified_completed": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "currently_attempting": {
                      "type": "string"
                    },
                    "remaining": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "verified_completed",
                    "currently_attempting",
                    "remaining"
                  ]
                },
                "current_subgoal": {
                  "type": "string"
                },
                "execution_status": {
                  "type": "string",
                  "enum": [
                    "not_started",
                    "progressing",
                    "failed",
                    "uncertain",
                    "recovered"
                  ]
                },
                "execution_evidence": {
                  "type": "string"
                },
                "expected_next_intent": {
                  "type": "string"
                },
                "predicted_next_intent": {
                  "type": "string"
                },
                "intent_status": {
                  "type": "string",
                  "enum": [
                    "aligned",
                    "misaligned",
                    "uncertain"
                  ]
                },
                "intent_evidence": {
                  "type": "string"
                }
              },
              "required": [
                "task_progress",
                "current_subgoal",
                "execution_status",
                "execution_evidence",
                "expected_next_intent",
                "predicted_next_intent",
                "intent_status",
                "intent_evidence"
              ]
            }
          },
          "required": [
            "request_id",
            "mode",
            "steps",
            "reason",
            "edit",
            "target",
            "assessment"
          ]
        },
        "output_dir": {
          "type": "string"
        }
      },
      "required": [
        "proposal_path",
        "response",
        "output_dir"
      ]
    }
  },
  {
    "type": "function",
    "name": "robodojo_report_grasp",
    "description": "Record current visual failure/held/recovered evidence without physics or inference. Use failed, held, then recovered at distinct increasing steps. Recovered saves and stops.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "failed",
            "held",
            "recovered"
          ]
        },
        "evidence": {
          "type": "string"
        }
      },
      "required": [
        "stage",
        "evidence"
      ]
    }
  }
]